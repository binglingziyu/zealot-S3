# Keep this file outside the database and protect the filled copy with chmod 600.
RAILS_ENV=production
SECRET_KEY_BASE=replace-with-the-original-external-secret
ZEALOT_DOMAIN=zealot.example.com
ZEALOT_STORAGE=s3
ZEALOT_POSTGRES_HOST=postgres
ZEALOT_POSTGRES_PORT=5432
ZEALOT_POSTGRES_USERNAME=zealot
ZEALOT_POSTGRES_PASSWORD=replace-me
ZEALOT_POSTGRES_DB_NAME=zealot
ZEALOT_POSTGRES_SSLMODE=disable
# Recovery CLI requires explicit POSTGRES settings; unset ZEALOT_DATABASE_URL.
ZEALOT_S3_BUCKET=infrastructure
ZEALOT_S3_REGION=auto
ZEALOT_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
ZEALOT_S3_ACCESS_KEY_ID=replace-me
ZEALOT_S3_SECRET_ACCESS_KEY=replace-me
ZEALOT_S3_FORCE_PATH_STYLE=true
# Exact prefix shown by the chosen profile and backup schedule ID:
ZEALOT_BACKUP_PREFIX=zealot/database-backups/1
# If backups use another account/bucket, set ZEALOT_BACKUP_S3_BUCKET, REGION,
# ENDPOINT, ACCESS_KEY_ID, SECRET_ACCESS_KEY, FORCE_PATH_STYLE here as well.
# Only enable this while all existing workers/web writers are stopped:
# ZEALOT_RECOVERY_MODE=true
