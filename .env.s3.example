ZEALOT_STORAGE=s3
ZEALOT_S3_BUCKET=your-private-bucket
ZEALOT_S3_REGION=us-east-1
# Omit ENDPOINT for AWS S3. For OSS use its documented S3-compatible endpoint.
ZEALOT_S3_ENDPOINT=https://s3.example.com
# Optional separate externally reachable S3 endpoint for browser downloads.
# It must accept S3 signatures; an arbitrary CDN domain is not interchangeable.
# ZEALOT_S3_DOWNLOAD_ENDPOINT=https://s3.example.com
# Public bucket only: direct unsigned downloads; never use this bucket for database backups.
# ZEALOT_S3_PUBLIC_DOWNLOAD_ORIGIN=https://infra.s3.mockdata.work
ZEALOT_S3_ACCESS_KEY_ID=
ZEALOT_S3_SECRET_ACCESS_KEY=
# Alternatively omit credentials and use the AWS SDK credential chain / IAM role.
# ZEALOT_S3_SESSION_TOKEN=
ZEALOT_S3_FORCE_PATH_STYLE=false
ZEALOT_S3_PREFIX=zealot
ZEALOT_S3_URL_EXPIRES_IN=3600
