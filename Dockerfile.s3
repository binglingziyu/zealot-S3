# Compatible extension of the pinned 6.2.2 runtime; preserves compiled assets.
FROM ghcr.io/tryzealot/zealot:6.2.2@sha256:72e80a1823aa09c213b9e29752042166dd8f689a511bb55bfde079a57a6764de
WORKDIR /app
COPY Gemfile Gemfile.lock ./
RUN bundle install --jobs 4 --retry 3 && rm -rf vendor/bundle/ruby/3.4.0/cache
COPY app/ ./app/
COPY lib/ ./lib/
COPY config/ ./config/
COPY db/ ./db/
ARG VCS_REF
ENV ZEALOT_VCS_REF=$VCS_REF
LABEL org.opencontainers.image.source="https://github.com/binglingziyu/zealot-S3"
