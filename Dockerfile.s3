ARG NODE_IMAGE=public.ecr.aws/docker/library/node:22-alpine
FROM --platform=$BUILDPLATFORM ${NODE_IMAGE} AS assets
WORKDIR /assets
RUN npm install --global pnpm@10.22.0
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY app/javascript/ ./app/javascript/
COPY app/assets/ ./app/assets/
RUN pnpm build && pnpm build:css

# Compatible extension of the pinned 6.2.2 runtime with freshly built clients.
FROM ghcr.io/tryzealot/zealot:6.2.2@sha256:72e80a1823aa09c213b9e29752042166dd8f689a511bb55bfde079a57a6764de
WORKDIR /app
COPY Gemfile Gemfile.lock ./
RUN bundle install --jobs 4 --retry 3 && rm -rf vendor/bundle/ruby/3.4.0/cache
COPY app/ ./app/
COPY lib/ ./lib/
COPY config/ ./config/
COPY db/ ./db/
COPY bin/parse_upload ./bin/parse_upload
COPY bin/database_archive ./bin/database_archive
COPY bin/object_migration ./bin/object_migration
COPY bin/service_account ./bin/service_account
COPY --from=assets /assets/app/assets/builds/ ./app/assets/builds/
COPY --from=assets /assets/node_modules/@fortawesome/fontawesome-free/webfonts/ ./node_modules/@fortawesome/fontawesome-free/webfonts/
# assets:clobber also deletes app/assets/builds through js/cssbundling hooks.
# Clear only inherited precompiled assets; preserve the freshly copied bundles.
RUN rm -rf public/assets && SKIP_JS_BUILD=1 SKIP_CSS_BUILD=1 SECRET_KEY_BASE=precompile_placeholder bundle exec rails assets:precompile
RUN ruby -rjson -e 'manifest = JSON.parse(File.read("public/assets/.manifest.json")); %w[application.css application.js].each { |name| abort("Missing built asset: #{name}") unless manifest[name] && File.size?(File.join("public/assets", manifest[name]["digested_path"])) }' 
ARG VCS_REF
ENV ZEALOT_VCS_REF=$VCS_REF
LABEL org.opencontainers.image.source="https://github.com/binglingziyu/zealot-S3"
