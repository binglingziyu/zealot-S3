- content_for :title do
  = @title
- content_for :section_title do
  = @title

.row.justify-content-center
  .col-12.col-md-8.col-lg-5
    .card
      .card-body.p-4
        p = t('install_links.enter_password')
        = form_with url: public_install_auth_path(@link.path), data: { turbo: false } do |f|
          .mb-3
            = f.label :password, t('install_links.access_password'), class: 'form-label'
            = f.password_field :password, required: true, maxlength: 72, autocomplete: 'current-password', class: "form-control #{@error_message ? 'is-invalid' : ''}", aria: { describedby: 'install-password-feedback', invalid: @error_message.present? }
            #install-password-feedback
              - if @error_message
                .text-danger.mt-2 role="alert" = @error_message
          = f.submit t('install_links.continue'), class: 'btn btn-primary w-100 py-3'
