
= turbo_frame_tag :channel, class: 'row channel-workspace', data: { turbo_action: :advance } do
  .col-12
    .card.channel-summary
      = app_icon(@app.recently_release, class: 'app-icon', alt: '')
      .channel-identity
        h2 = @app.name
        p
          = @channel.scheme.name
          |  /
          = channel_platform(@channel)
      - if current_user&.manage?(app: @app) && !@app.archived
        = link_to new_channel_release_path(channel), class: 'btn btn-primary', data: { turbo: false } do
          i.icon.fa-solid.fa-arrow-up-from-bracket aria-hidden="true"
          = t('channels.show.upload_release')
  .col-md-8
    == render 'mobile_menu'
    == render 'activity'
    - if current_user&.manage?(app: @app)
      == render 'web_hooks'

  .col-md-4
    == render 'schemes'
    == render 'channels'
    == render 'versions'
    == render 'metadata'

    - if user_signed_in_or_guest_mode?
      = link_to app_path(@app), class: 'btn btn-secondary w-100 mt-3', data: { turbo: false } do
          i.icon.fa-regular.fa-list-alt
          = t('channels.show.view_app')
