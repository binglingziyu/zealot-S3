<% content_for :title, @title %><% content_for :section_title, @title %>
<div class="d-flex align-items-center justify-content-between gap-3 mb-3"><p class="mb-0 text-body-secondary">为分组和应用配置存储。应用的选择优先于分组默认设置。</p><%= link_to '添加存储', new_storage_profile_path, class: 'btn btn-primary text-nowrap' %></div>
<div class="card"><div class="card-body table-responsive"><table class="table align-middle"><caption>已配置的对象存储；密钥不会显示在列表中</caption><thead><tr><th scope="col">名称</th><th scope="col">Bucket</th><th scope="col">状态</th><th scope="col">操作</th></tr></thead><tbody>
<% @profiles.each do |profile| %><tr><td><%= profile.name %><% if profile.system_default? %><span class="badge text-bg-primary ms-2">系统默认</span><% end %></td><td><%= profile.bucket %><br><span class="text-body-secondary"><%= profile.region %></span></td><td><%= profile.enabled? ? '允许新上传' : '已停用新上传' %></td><td><div class="d-flex flex-wrap gap-2"><%= link_to '编辑', edit_storage_profile_path(profile), class: 'btn btn-outline-primary' %><%= button_to '检查连接', check_storage_profile_path(profile), class: 'btn btn-outline-secondary' %><%= button_to '删除', storage_profile_path(profile), method: :delete, class: 'btn btn-outline-danger', form: { data: { turbo_confirm: '确认删除未被引用的存储配置？' } } %></div></td></tr><% end %>
</tbody></table><% if @profiles.empty? %><p>尚未配置对象存储。添加后可绑定到分组或应用。</p><% end %></div></div>
