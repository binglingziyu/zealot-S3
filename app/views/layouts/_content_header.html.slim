ruby:
  section_title = yield :section_title
  right_panel = yield :section_rightpanel
  description = yield :section_description

- if section_title.present?
  .app-content-header
    .container-fluid
      .page-heading
        div
          h1.section-title = section_title
          - if description.present?
            p.page-description = description
        - if right_panel.present?
          .page-actions = right_panel
- else
  .pt-3
