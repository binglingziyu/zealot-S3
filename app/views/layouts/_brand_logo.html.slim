= turbo_frame_tag 'site_title' do
  = link_to root_path, class: 'navbar-brand', data: { turbo: false } do
    = image_tag 'zealot-icon.png', class: 'brand-image brand-light', alt: ''
    = image_tag 'zealot-icon-dark.png', class: 'brand-image brand-dark', alt: ''
    span.brand-text.fw-light = site_title
