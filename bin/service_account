# frozen_string_literal: true

require_relative '../config/environment'
action, actor_id, identity, role, *app_ids = ARGV
actor = User.find(actor_id)
account = case action
when 'create'
  Access::ServiceAccounts.create!(actor: actor, name: identity, role: role, app_ids: app_ids)
when 'grant'
  Access::ServiceAccounts.grant!(actor: actor, account: User.find(identity), role: role, app_ids: app_ids)
when 'rotate'
  Access::ServiceAccounts.rotate!(actor: actor, account: User.find(identity))
when 'revoke'
  Access::ServiceAccounts.revoke!(actor: actor, account: User.find(identity))
else
  raise ArgumentError, 'Usage: ruby bin/service_account create ADMIN_ID NAME read/upload APP_IDS... | grant ADMIN_ID ACCOUNT_ID read/upload APP_IDS... | rotate/revoke ADMIN_ID ACCOUNT_ID'
end
result = { id: account.id, username: account.username, active: account.api_access_active? }
result[:token] = account.token if %w[create rotate].include?(action)
puts JSON.pretty_generate(result)
